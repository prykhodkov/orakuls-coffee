# Скопіювати в backend/.env і підставити свої значення. Реальний .env у git не потрапляє.
# Значення з символом $ (хеш пароля) беруться в ОДИНАРНІ лапки: у подвійних docker compose вважає $… змінною
# і виводить попередження. Пробіли теж потребують лапок.

# База даних. Для docker-compose хост — `db`.
DB_HOST=db
DB_PORT=3306
DB_NAME=orakuls
DB_USER=orakuls
DB_PASS=orakuls
# Лише для docker-compose (root-пароль локального MySQL)
DB_ROOT_PASS=root

# Адмін (використовується з BE-004). Пароль зберігається тільки як хеш: php -r "echo password_hash('...', PASSWORD_DEFAULT);"
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=''

# Ключ підпису токена (BE-004): довгий випадковий рядок, на кожному оточенні свій
TOKEN_SECRET=''
TOKEN_TTL_HOURS=168
