# Базова адреса API (див. docs/API.md)
VITE_API_URL=/api

# Мок-API на localStorage замість бекенду. У продакшн-збірці завжди false.
VITE_API_MOCK=false

# Адреса бекенду для dev-проксі (лише для vite dev, у бандл не потрапляє)
API_PROXY_TARGET=

# Адреса сайту без слеша в кінці — для og:image (соцмережі вимагають повний URL) і посилання в «Поделиться».
VITE_SITE_URL=https://orakulscoffee.com
