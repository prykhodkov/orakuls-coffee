# Базова адреса API (див. docs/API.md)
VITE_API_URL=/api

# Мок-API на localStorage замість бекенду. У продакшн-збірці завжди false.
VITE_API_MOCK=false

# Адреса бекенду для dev-проксі (лише для vite dev, у бандл не потрапляє)
API_PROXY_TARGET=

# Адреса сайту без слеша в кінці, напр. https://orakuls.lv — для og:image (соцмережі вимагають повний URL).
# TODO: заповнити, коли буде домен
VITE_SITE_URL=
